{
  "name": "troll-code",
  "displayName": "Mischievous",
  "description": "A prank extension for VS Code. Three modes: Legit (light jokes), Troll (sneaky — edits text as you type) and opt-in Hardcore (pure chaos). Use at your own risk. Panic button: Ctrl+Alt+Shift+P.",
  "version": "1.18.2",
  "publisher": "bochenek11",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bochenek11/troll-code.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "prank"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "npx @vscode/vsce package --no-dependencies --allow-missing-repository",
    "publish": "npx @vscode/vsce publish --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "trollCode.switchMode",
        "title": "Troll Code: Wybierz tryb (Legit / Troll / Hardcore)"
      },
      {
        "command": "trollCode.toggle",
        "title": "Troll Code: Włącz/wyłącz trolling"
      },
      {
        "command": "trollCode.rainbowToggle",
        "title": "Troll Code: 🌈 Tryb tęczowy HARDKOR (włącz/wyłącz)"
      },
      {
        "command": "trollCode.panic",
        "title": "Troll Code: 🛑 PANIC — wyłącz wszystko"
      },
      {
        "command": "trollCode.trollNow",
        "title": "Troll Code: Trolluj mnie teraz"
      },
      {
        "command": "trollCode.shakeNow",
        "title": "Troll Code: Trzęsienie ekranu teraz"
      },
      {
        "command": "trollCode.waifuNow",
        "title": "Troll Code: Pokaż waifu teraz"
      },
      {
        "command": "trollCode.bsodNow",
        "title": "Troll Code: Niebieski ekran (BSOD) teraz"
      }
    ],
