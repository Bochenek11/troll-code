    "keybindings": [
      {
        "command": "trollCode.sassyUndo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "editorTextFocus && !editorReadonly && config.trollCode.enabled && config.trollCode.sassyUndo.enabled && config.trollCode.mode == 'troll' || editorTextFocus && !editorReadonly && config.trollCode.enabled && config.trollCode.rainbowMode.enabled"
      },
      {
        "command": "trollCode.panic",
        "key": "ctrl+alt+shift+p",
        "mac": "cmd+alt+shift+p"
      }
    ],
    "configuration": {
      "title": "Troll Code",
      "properties": {
        "trollCode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Główny włącznik wszystkich efektów."
        },
        "trollCode.mode": {
          "type": "string",
          "enum": [
            "legit",
            "troll"
          ],
          "enumDescriptions": [
            "😇 Legit: lekkie żarty, które nie przeszkadzają w pracy (komentarze, fałszywy postęp, komentarze przy zapisie, żartobliwe podpowiedzi).",
            "🤡 Troll: SNEAKY. Bez paska statusu i bez powiadomień. Podczas pisania po cichu psuje składnię (średnik, kropka, nawiasy, znaczniki HTML na bliźniacze znaki; czasem litera hebrajska). Zmienia tekst w pliku — cofniesz Ctrl+Z, na dysk trafia po zapisie."
          ],
          "default": "legit",
          "description": "Tryb trollingu. Hardcore włącza się osobno (trollCode.rainbowMode.enabled) i wymaga potwierdzenia."
        },
        "trollCode.rainbowMode.enabled": {
          "type": "boolean",
          "default": false,
          "description": "☠️ Tryb Hardcore: totalny chaos (tęczowy tekst, zamykanie kart, ruletka motywów, kot, fałszywe błędy i dużo więcej, pełna lista w README). Przed włączeniem trzeba potwierdzić ostrzeżenie. Zmienione ustawienia wracają po wyłączeniu. PANIC: Ctrl+Alt+Shift+P."
        },
        "trollCode.hardcore.closeTabsMs": {
          "type": "number",
          "default": 3000,
          "minimum": 50,
          "description": "[tryb Hardcore] Odstęp w milisekundach: zamykanie zapisanych kart. Domyślnie 3000 ms."
        },
        "trollCode.hardcore.closeWebTabsMs": {
          "type": "number",
          "default": 60000,
          "minimum": 50,
          "description": "[tryb Hardcore] Odstęp w milisekundach: zamykanie plików HTML/CSS/JS. Domyślnie 60000 ms."
        },
        "trollCode.hardcore.shakeMs": {
          "type": "number",
          "default": 4000,
          "minimum": 50,
          "description": "[tryb Hardcore] Odstęp w milisekundach: trzęsienie ekranu. Domyślnie 4000 ms."
        },
        "trollCode.hardcore.waifuMs": {
          "type": "number",
          "default": 20000,
          "minimum": 50,
